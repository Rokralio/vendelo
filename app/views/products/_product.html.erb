<%= link_to product_path(product), class: 'product bg-white mb-2 rounded', data: { turbo_frame: '_top'} do %>
  <%= image_tag product.photo, class:"w-full h-60 object-cover" if product.photo.attached? %>
  <div class="mt-2">
    <spam class="fond-bold text-xl"><%= product.price %>$</spam>
    <h2 class=""><%= product.title %></h2>
    <p class="text-gray-500 text-sm mt-2"><%= product.description %></p>
  </div>
<% end %>
