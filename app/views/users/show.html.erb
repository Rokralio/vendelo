<%= @user.username %>

<%= turbo_frame_tag "products", class: 'products' do %>
  <%= render partial: 'products/product', collection: @products %>

  <div class="pagination">
    <% if @pagy.prev %>
      <%= link_to "Anterior", pagy_url_for(@pagy, @pagy.prev), data: { turbo_frame: "products" }, class: "pagination-button" %>
    <% end %>

    <% if @pagy.next %>
      <%= link_to "Siguiente", pagy_url_for(@pagy, @pagy.next), data: { turbo_frame: "products" }, class: "pagination-button" %>
    <% end %>
  </div>
<% end %>